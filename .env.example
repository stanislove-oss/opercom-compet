# Скопировать в .env и заполнить. Сам .env в git не попадает.
#
# Комментарии — только отдельными строками. Если написать комментарий в конце
# строки с пустым значением, он станет значением: CLICKHOUSE_DATABASE=  # база
# прочитается как база с именем "# база".

# --- Какая база ------------------------------------------------------------
# clickhouse — новая база, mssql — прежняя (для сверки и отката)
DB_ENGINE=clickhouse

# --- ClickHouse ------------------------------------------------------------
CLICKHOUSE_HOST=
# 8123 — HTTP, 8443 — HTTPS
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Имя базы можно не заполнять: python scripts/dump_schema.py --list покажет доступные
CLICKHOUSE_DATABASE=mediascope_x5_big_v22
# true для порта 8443
CLICKHOUSE_SECURE=false

# --- Две витрины -----------------------------------------------------------
# Данные разъехались по двум базам, и это осознанный выбор, а не костыль
# (замерено в соседнем проекте на этой же базе, август 2026):
#
#   * затраты в v22 заканчиваются май'26 — строк за июнь и дальше там нет,
#     в v23 они есть;
#   * рейтинги брать из v23 нельзя: у reg_tv там две колонки рейтингов
#     вместо пятидесяти двух, и нужного RtgPer_w_ALL_18+ нет вовсе.
#
# Поэтому база по умолчанию — v22 (оттуда рейтинги), а таблица затрат
# указывается вместе со своей базой:
COST_TABLE=mediascope_x5_big_v23.media_costs_union

# Рейтинги: пусто — берутся из базы по умолчанию.
NAT_TV_TABLE=
BIG_TV_TABLE=
REG_TV_TABLE=

# Что где лежит:
#   python scripts/dump_schema.py --list
#   python scripts/dump_schema.py --database mediascope_x5_big_v23

# --- Дубли в базе ----------------------------------------------------------
# Отчёт суммирует строки как есть. Если одна строка лежит в таблице дважды,
# деньги удвоятся молча.
#
#   off (по умолчанию) — суммировать все строки подряд. Так же считает ручная
#       версия отчёта, с которой сверяются коллеги;
#   identical — убрать строки, совпадающие целиком, по ВСЕМ колонкам таблицы.
#       Замерено на этой базе: 0.3% строк и 0.08% денег, все в наружке;
#   key — оставлять одну строку на ключ, даже если суммы разные. Это минус
#       1.95% всех затрат и около 15% наружки: включать, только убедившись,
#       что эти строки — мусор.
DEDUPE=off

# --- Фильтры, которых не было в SQL Server ---------------------------------
# ОБА ВЫКЛЮЧЕНЫ, и это принципиально: в прежних запросах их не было, а переезд
# не должен менять цифры сам по себе. Сначала выгрузки должны сойтись со старой
# базой, и только потом имеет смысл обсуждать, надо ли что-то отфильтровывать.
# Сколько каждый режет на нашей выборке: python scripts/check_filters.py
# Включить, только убедившись, что фильтр не режет лишнего (check_filters.py):
# ESTAT_FILTER=estat = 'R'
CLEANING_FILTER=

# --- Прежняя база: нужна для сверки и отката --------------------------------
# Прежние имена переменных менять не надо: слой сам найдёт SQL_SERVER и прочие.
MSSQL_HOST=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=

# --- Пути и режим работы сервиса --------------------------------------------
# "db"  — выгрузка из базы (боевой режим)
# "csv" — локальные снимки из dummy_df/ (отладка без базы и сетевой шары)
OPERCOM_DATA_SOURCE=db

# Корни сетевых шар с исходными Excel-файлами.
# На Windows — как есть; на Linux — точки монтирования той же шары.
OPERCOM_MMO_DATA_ROOT=Z:\clients\!market_data\data_bases
OPERCOM_DIGITAL_DATA_ROOT=Z:\clients\retail\food_retail\x5\data_bases

# Шаблон презентации и папка с результатами прогонов.
# OPERCOM_TEMPLATE_PPTX=templates_pptx/Х5_Оперком_март_v3_fin_named.pptx
# OPERCOM_RUNS_ROOT=runs

# Сколько последних прогонов держать на диске (0 — не чистить).
OPERCOM_KEEP_RUNS=20

# Потолок на один прогон в секундах (0 — без ограничения).
OPERCOM_RUN_TIMEOUT_SEC=3600

# Выполнять ли dev-ячейки (дампы снимков, сверка с baseline).
OPERCOM_RUN_DEV_CELLS=0
