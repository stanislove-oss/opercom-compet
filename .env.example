# --- Подключение к оффлайн-базе (читается ячейкой 1 ноутбука) ----------------
HOST=
USER=
PASSWORD=
DB_NAME=

# --- Пути и режим работы сервиса --------------------------------------------
# "db"  — MySQL + Google Sheets (боевой режим)
# "csv" — локальные снимки из dummy_df/ (отладка без БД и сетевой шары)
OPERCOM_DATA_SOURCE=db

# Корни сетевых шар с исходными Excel-файлами.
# На Windows — как есть; на Linux — точки монтирования той же шары.
OPERCOM_MMO_DATA_ROOT=Z:\clients\!market_data\data_bases
OPERCOM_DIGITAL_DATA_ROOT=Z:\clients\retail\food_retail\x5\data_bases

# Шаблон презентации и папка с результатами прогонов.
# OPERCOM_TEMPLATE_PPTX=templates_pptx/Х5_Оперком_март_v3_fin_named.pptx
# OPERCOM_RUNS_ROOT=runs

# Сколько последних прогонов держать на диске (0 — не чистить).
OPERCOM_KEEP_RUNS=20

# Потолок на один прогон в секундах (0 — без ограничения).
OPERCOM_RUN_TIMEOUT_SEC=3600

# Выполнять ли dev-ячейки (дампы снимков, сверка с baseline).
OPERCOM_RUN_DEV_CELLS=0
